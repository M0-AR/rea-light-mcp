{
  "name": "rea-light-mcp",
  "version": "0.1.0",
  "description": "Lightweight MCP facade for REA (Reverse Engineer Anything) — 4 flat tools, depth-1 schemas, full REA behind",
  "main": "dist/index.js",
  "mcpName": "rea-light-mcp",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "check:schemas": "tsx scripts/check-schemas.ts"
  },
  "keywords": ["mcp", "rea", "reverse-engineering", "facade", "light"],
  "author": "md-ar",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "rea-light-mcp": "dist/index.js"
  },
  "files": ["dist/**/*", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
